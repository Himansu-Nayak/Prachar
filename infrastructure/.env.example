# ==========================================
# PRACHAR PLATFORM - ENVIRONMENT CONFIGURATION
# ==========================================

# Database Configuration (PostgreSQL 16)
POSTGRES_DB=prachar_db
POSTGRES_USER=prachar_user
POSTGRES_PASSWORD=prachar_dev_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis Cache Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Backend Spring Boot Configuration
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Security (JWT)
JWT_SECRET=prachar_super_secret_jwt_key_at_least_256_bits_length_for_hmac_sha256_dev_only
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# Public App Base URL
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8080
