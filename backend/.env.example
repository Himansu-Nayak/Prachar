# PRACHAR Backend — Local Development Environment Variables
# ============================================================
# DO NOT COMMIT THIS FILE. It is listed in .gitignore.
# ============================================================
# Copy this file to .env and fill in your actual values.
# Used when running: mvn spring-boot:run (dev profile)
# ============================================================

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=Prachar1
DB_USERNAME=postgres
# DB_PASSWORD=<set your PostgreSQL password here — never commit the actual password>

# Spring Profile
SPRING_PROFILES_ACTIVE=dev

# CORS (frontend dev server)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# JWT Secret (change in production)
# JWT_SECRET=<set a strong secret — at least 256 bits / 32+ chars>

# Razorpay Payment Gateway (Phase 7)
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=placeholder_secret_key_2026
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret_2026
RAZORPAY_SIMULATION_MODE=true

